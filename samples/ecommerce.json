{
  "summary": {
    "title": "Online Bookstore",
    "description": "A web storefront talks to an Orders API behind an Nginx gateway. Orders are stored in Postgres, sessions are cached in Redis, and order events go to RabbitMQ for an email worker.",
    "data_flow": "Browser → Nginx → Orders API → Postgres; Orders API → RabbitMQ → Email Worker → SendGrid",
    "recommended_stack": {
      "Storefront": "React + Vite",
      "Orders API": "Node.js + Express",
      "Email Worker": "Python",
      "Database": "PostgreSQL 16",
      "Cache": "Redis 7",
      "Queue": "RabbitMQ 3"
    }
  },
  "graph": {
    "nodes": [
      {"id": "browser", "label": "Browser", "kind": "external", "ports": []},
      {"id": "storefront", "label": "Storefront (React)", "kind": "frontend", "ports": [3000], "tech": "react"},
      {"id": "gateway", "label": "Nginx", "kind": "gateway", "ports": [80]},
      {"id": "orders-api", "label": "Orders API", "kind": "service", "ports": [3000], "tech": "express"},
      {"id": "orders-db", "label": "Orders DB (Postgres)", "kind": "database", "ports": [5432]},
      {"id": "cache", "label": "Redis", "kind": "cache", "ports": []},
      {"id": "queue", "label": "RabbitMQ", "kind": "queue", "ports": [5672]},
      {"id": "email-worker", "label": "Email Worker", "kind": "service", "ports": [], "tech": "python"},
