# Where the open-weight models run: "ollama" (local, offline) or "hosted"
LLM_PROVIDER=ollama

# Ollama native API (not the /v1 OpenAI shim: we need keep_alive, format and think)
OLLAMA_BASE_URL=http://localhost:11434

# --- Hosted: DigitalOcean Serverless Inference (OpenAI-compatible) ---
# Create a "model access key" in the DigitalOcean control panel. Never commit the real key.
# Then set LLM_PROVIDER=hosted and swap the model names below for the hosted ones:
#   VISION_MODEL=gemma-4-31B-it
#   OCR_MODEL=gemma-4-31B-it
#   AGENT_MODEL=openai-gpt-oss-20b
# Check them with:  python -m app.check_provider
HOSTED_BASE_URL=https://inference.do-ai.run/v1
HOSTED_API_KEY=

# --- Fallback provider (optional): retried when a hosted/Ollama call fails ---
# Groq by default (OpenAI-compatible, open-weight models). Setting the key enables it.
# FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK_VISION_MODEL=qwen/qwen3.8-27b
# FALLBACK_OCR_MODEL=qwen/qwen3.8-27b
# FALLBACK_AGENT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Models (change here only, never in code)
VISION_MODEL=gemma3:4b
OCR_MODEL=qwen2.5vl:3b
# qwen3:1.7b can disable thinking (fast). qwen3:4b here is the Thinking-2507 build: it always
# reasons before each tool call (~15 min per run on CPU). Use it only with a GPU.
AGENT_MODEL=qwen3:1.7b

# Agent loop
AGENT_MAX_TURNS=8
AGENT_THINK=false

# Image preprocessing
IMAGE_MAX_SIDE=1024

# Seconds a single model call may take (CPU inference is slow)
LLM_TIMEOUT=600
